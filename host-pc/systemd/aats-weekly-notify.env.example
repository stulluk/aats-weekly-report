# Copy to ~/.config/aats-weekly-notify.env and chmod 600.
# Used by aats-weekly-filled-check.service (systemctl --user).

REPO_ROOT=/media/KINGDATA/DREJO-PROJECTS/aats-weekly-report
AML_USER=you
AML_PWD=secret

# Reach AATS (VPN PC often needs internal host or IP)
AATS_BASE_URL=http://aats.amlogic.com

# Same topic path on kernelmax and on ntfy.sh (only the host differs).
# If your server needs auth: https://USER:TOKEN@ntfy.kernelmax.com/aats-weekly-sumup-fae
NTFY_URL=https://ntfy.kernelmax.com/aats-weekly-sumup-fae

# Optional: force report date (otherwise: today, or main HTML write-date when present)
# AATS_REPORT_DATE=2026-05-03

# How many prior weeks to scan for substantive data when target-7 is empty (default 4).
# AATS_MAX_WEEKS_BACK=4

# Label prefix used in every ntfy / desktop notification title; defaults to `hostname -s`.
# Set per machine, e.g. AATS_HOST_TAG=amdpc on the laptop, AATS_HOST_TAG=dumpling on the server.
# AATS_HOST_TAG=amdpc

# Desktop pop-up (host-pc only)
AATS_NOTIFY_DESKTOP=1

# Host PC: fail fast with ntfy if /weekly_sumup_fae/main is not reachable (Forti off / no route)
AATS_VPN_PREFLIGHT=1
